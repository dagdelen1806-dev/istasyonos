# Bağımsız geliştirme ortamı. Gerçek değerleri Git'e eklemeyin.
NODE_ENV=development
PORT=3000
AUTH_PROVIDER=local
APP_ID=istasyonos
# En az 32 rastgele karakter; tüm sunucu örneklerinde sabit tutulmalı.
SESSION_SECRET=
DATABASE_URL=
# Üretimde true ve HTTPS kullanın. false yalnız yerel geliştirme içindir.
COOKIE_SECURE=true
# İsteğe bağlı kurulum sahibi kısıtı.
OWNER_OPEN_ID=
# Manus adaptörü isteğe bağlıdır; local mod için gerekmez.
# AUTH_PROVIDER=manus
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=
